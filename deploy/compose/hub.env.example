# Copy to hub.env (git-ignored) and fill in. Generate secrets with: openssl rand -base64 32
HUB_NAME=hub-1
HUB_HOSTNAME=takada-hub.local
ADMIN_TOKEN=
PHC_SCRIBE_API_KEY=
# sha256 of PHC_SCRIBE_API_KEY: printf %s "$PHC_SCRIBE_API_KEY" | sha256sum
PHC_SCRIBE_KEY_HASH=
# llamacpp: the fine-tuned N-ATLaS (start with --profile model, after fetching the models:
# docs/operations.md). keyword: the rules-only fallback, if the hub cannot run the model.
PHC_EXTRACTOR=llamacpp
# Speech to text on the hub, from the models volume (no network needed): ct2 serves the int8
# builds (phc-scribe ADR-0032; 6-7x faster on a laptop CPU, word errors within 1 point of
# fp32); hf serves the fp32 fine-tunes (ADR-0026); off disables recordings (notes only).
PHC_ASR=ct2
PHC_ASR_INT8_MODELS=en=/models/asr-int8/en,yo=/models/asr-int8/yo,pcm=/models/asr-int8/pcm
# The fp32 models: used with PHC_ASR=hf, and for any language not listed above.
PHC_ASR_MODELS=yo=/models/asr-ft/yo,pcm=/models/asr-ft/pcm
WORKERS=1
